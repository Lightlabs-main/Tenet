# Tenet - example environment. Copy to .env and fill in. Never commit .env.

# --- Solana ---
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Mainnet write guard (see docs/verification-plan.md section 9) ---
# Read-only by default. Writes ALSO require an explicitly supplied funded signer.
ALLOW_MAINNET_WRITES=false
# Path to a funded keypair. NEVER commit a keypair. NEVER print a private key.
MAINNET_SIGNER_KEYPAIR=

# --- Pyth (V-007: upgraded Hermes requires an API key after 2026-08-26) ---
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=

# --- Jupiter (V-008: current Swap V2 verification requires an API key) ---
JUPITER_API_BASE=https://lite-api.jup.ag
JUPITER_API_KEY=

# --- PreStocks issuer API (V-001) ---
PRESTOCKS_API_URL=https://prestocks.com/api/prestocks
